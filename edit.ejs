<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <header>
    <h1>Edit Post</h1>
  </header>

  <main>
    <section class="box">
      <form action="/posts/<%= post.id %>/edit" method="POST">

        <label>Name</label>
        <input type="text" name="name" value="<%= post.name %>" required>

        <label>Title</label>
        <input type="text" name="title" value="<%= post.title %>" required>

        <label>Category</label>
        <select name="category">
          <option value="Tech" <%= post.category === "Tech" ? "selected" : "" %>>Tech</option>
          <option value="Lifestyle" <%= post.category === "Lifestyle" ? "selected" : "" %>>Lifestyle</option>
          <option value="Education" <%= post.category === "Education" ? "selected" : "" %>>Education</option>
          <option value="Other" <%= post.category === "Other" ? "selected" : "" %>>Other</option>
        </select>

        <label>Post</label>
        <textarea name="content" rows="8" required><%= post.content %></textarea>

        <button type="submit">Save Changes</button>
        <a href="/" class="back">Cancel</a>

      </form>
    </section>
  </main>

</body>
</html>
