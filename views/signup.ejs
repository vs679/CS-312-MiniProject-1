<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header>
        <h1>Blog App</h1>
    </header>

    <main class="auth-main">
        <section class="box">
            <h2>Sign Up</h2>

            <% if (error) { %>
                <p class="error" role="alert">
                    <%= error %>
                </p>
            <% } %>

            <form method="POST" action="/signup">
                <label for="user_id">
                    User ID
                </label>
                <input
                    id="user_id"
                    name="user_id"
                    required
                    maxlength="255"
                    autocomplete="username"
                >

                <label for="name">
                    Name
                </label>
                <input
                    id="name"
                    name="name"
                    required
                    maxlength="255"
                    autocomplete="name"
                >

                <label for="password">
                    Password
                </label>
                <input
                    id="password"
                    type="password"
                    name="password"
                    required
                    autocomplete="new-password"
                >

                <button type="submit">
                    Sign Up
                </button>
            </form>

            <p>
                Already have an account?
                <a href="/signin">Sign in</a>
            </p>
        </section>
    </main>
</body>

</html>
